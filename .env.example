# ==========================================
# Smokingpipes 特价斗草监控系统配置文件
# ==========================================

# 1. 监控基础设置
# 监控地址（默认即可）
SPECIALS_URL=https://www.smokingpipes.com/specials.cfm?specials=pipe-tobaccos

# 轮询频率（分钟，推荐 15-30 分钟）
CHECK_INTERVAL_MINUTES=30

# 单月海关美元计征汇率 (海关总署第272号令：每月计征汇率=上月第三个周三央行汇率中间价)
# 可直接填入当月核定汇率（如 2026年10月为 6.7628）；若填 0 或留空，系统会自动根据海关法定算法联网获取基准日中间价
CUSTOMS_USD_RATE=6.7628

# 是否仅提醒有现货的特价斗草（true: 忽略缺货 / false: 缺货也提醒）
ONLY_IN_STOCK=false

# 首次启动程序时，是否发送当前在售全部特价草清单
NOTIFY_ON_STARTUP=true

# 每日定时汇总推送时间 (格式 HH:MM，留空则不推送；默认留空避免每日重复打扰)
DAILY_REPORT_TIME=

# ==========================================
# 2. 微信通知渠道（根据需要配置至少一项）
# ==========================================

# 方案 A：企业微信自建应用（推荐！可直推个人普通微信，有卡片和点击直达）
# 注册企业微信后在后台创建应用即可获取
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID=
WECOM_TO_USER=@all

# 企业微信 API 反向代理（极其关键！如果部署在 NAS/无固定公网 IPv4 环境，填入你的 SGW1 企微代理）
# 例如: http://140.245.40.253:56789 (在企微后台把 140.245.40.253 加入可信 IP 即可，留空默认直连官方 API)
WECOM_PROXY_URL=http://140.245.40.253:56789

# 方案 B：企业微信群机器人 Webhook（最简单！企微建群添加机器人即可）
# 例如: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WECOM_WEBHOOK_URL=

# 方案 C：PushPlus 个人微信公众号推送（备选）
# 微信扫码关注 pushplus.plus 获取 token 填入即可
PUSHPLUS_TOKEN=

# ==========================================
# 3. 网络与代理（可选）
# ==========================================
# 如果在国内 NAS 部署且无法直连 SP 站，可配置本地代理（如 http://192.168.1.x:7890）
# 如果在海外 VPS 部署，留空即可
HTTP_PROXY=
